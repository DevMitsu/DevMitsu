# Security headers for Netlify (Cloudflare Pages reads this file too). Same rules as firebase.json.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
/index.html
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
