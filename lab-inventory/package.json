{
  "name": "lab-inventory",
  "version": "1.0.0",
  "description": "School science lab inventory: physics, chemistry and biology. Stock, usage, accidents, spills, requirements.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "preview": "vite preview",
    "build:single": "vite build --assetsInlineLimit 100000000 && node scripts/write-config.mjs && node scripts/inline.mjs",
    "postbuild": "node scripts/write-config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "immer": "^11.2.10",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  }
}
